{
  "name": "clase-web",
  "productName": "Clase Web",
  "version": "1.3.1",
  "description": "Visor de escritorio para el contenido de clase-web.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acierto-incomodo/clase-web.git"
  },
  "keywords": [],
  "author": "acierto-incomodo <meliodas.aitor@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/acierto-incomodo/clase-web/issues"
  },
  "homepage": "https://github.com/acierto-incomodo/clase-web#readme",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "artifactName": "Clase-Web-Setup-${arch}.${ext}",
    "appId": "com.stormgamesstudios.clase-web",
    "productName": "Clase Web",
    "icon": "img/logo_2048x2048.png",
    "files": [
      "main.js",
      "img/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "acierto-incomodo",
      "repo": "clase-web"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "allowToChangeInstallationDirectory": false,
      "include": "installer.nsh",
      "differentialPackage": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "img/logo_2048x2048.png"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    }
  }
}
