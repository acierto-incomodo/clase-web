{
  "name": "clase-web",
  "productName": "Clase Web",
  "version": "1.2.1",
  "description": "Visor de escritorio para el contenido de clase-web.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --linux",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acierto-incomodo/clase-web.git"
  },
  "keywords": [],
  "author": "acierto-incomodo <meliodas.aitor@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/acierto-incomodo/clase-web/issues"
  },
  "homepage": "https://github.com/acierto-incomodo/clase-web#readme",
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "artifactName": "Clase-Web-Setup.${ext}",
    "appId": "com.stormgamesstudios.clase-web",
    "icon": "img/logo_2048x2048.png",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "img/**/*",
      "akademia/**/*",
      "asignaturas/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "acierto-incomodo",
      "repo": "clase-web"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "img/logo_2048x2048.png"
    }
  }
}
